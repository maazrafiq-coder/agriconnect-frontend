# API base URL (NestJS backend, including the /api/v1 prefix)
VITE_API_URL=http://localhost:3000/api/v1

# Demo/sample data fallback — OFF by default.
#
# When a data-loading API call fails, the app shows a real loading / error /
# empty state so failures are never hidden (see P0 #10 in the fix backlog).
# Setting this to "true" opts a deployment into showing bundled sample data
# instead of that error state, for demos where a live backend may be
# unavailable. Never enable this in production or during testing — it will
# mask real API/backend failures.
VITE_DEMO_MODE=false
